{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slopus",
  "version": "0.1.1",
  "identifier": "com.slopus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Slopus - 0.1.1",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "decorations": true,
        "resizable": true,
        "backgroundColor": "#080a0f",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' blob: data:; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../lib/slopfab/slopfab.dll": "slopfab.dll"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local AI media harness",
    "longDescription": "An AI media harness for planning, generating, and editing media locally—bringing AI agents, generative models, and creative tools into one desktop app. This release supports video workflows.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bitti-ai/slopus/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDOTFDOTkyMDJGM0NBMEIKUldRTHl2TUNrc21SM0JqYnVrWVEvckhrdEliSkFMMDQ4YThCVWM3UzNVaHV4NGlFanN1SXZwWXQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
